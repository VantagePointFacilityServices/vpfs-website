# Copy to dns/.env (gitignored) and fill in real values. Never commit .env.

# API token, not the Global API Key: Cloudflare dashboard > My Profile >
# API Tokens > Create Token > "Edit zone DNS" template, scoped to every
# zone listed under dns/zones/ (currently vantagepointfacilityservices.com.au
# and vantagepointfacilityservices.com). Needs Zone:DNS:Edit and Zone:Zone:Read
# on each. The script resolves each zone's ID by the `zone:` name in its
# own file — no zone ID/name env vars needed here.
CLOUDFLARE_API_TOKEN=
