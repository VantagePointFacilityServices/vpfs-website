# Copy to dns/.env (gitignored) and fill in real values. Never commit .env.

# API token, not the Global API Key: Cloudflare dashboard > My Profile >
# API Tokens > Create Token > "Edit zone DNS" template, scoped to the
# vantagepointcommercial.com.au zone. Needs Zone:DNS:Edit and Zone:Zone:Read.
CLOUDFLARE_API_TOKEN=

# Optional — the script resolves the zone by name (below) if this is unset.
# Only set this if you have more than one zone with the same name, or want
# to skip the lookup call.
CLOUDFLARE_ZONE_ID=

# Defaults to vantagepointcommercial.com.au (hardcoded in sync-dns.mjs) if unset.
CLOUDFLARE_ZONE_NAME=vantagepointcommercial.com.au
